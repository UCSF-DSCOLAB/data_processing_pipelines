
params {
    salmon_quant_libtype= null
    fragment_length_mean= 200
    fragment_length_std = 20
    gtf_extra_attributes= 'gene_name'
    gtf_group_features  = 'gene_id'
    umitools_dedup_stats= false
    filter_rrna         = true
    format_contigs      = false
    adapter_sequence_1  = "CTGTCTCTTATACACATCT"
    adapter_sequence_2  = "CTGTCTCTTATACACATCT"

    // Genotype-sensitive preprocessing. Overlap correction can change bases and
    // is disabled by default for reads used by the SNP-calling branch.
    expression_fastp_overlap_correction   = true

    // STAR arguments for reliable allele evidence. Prefer uniquely mapped reads
    // for donor genotyping; this can be overridden for benchmarking.
    star_outfilter_mismatch_n_over_lmax   = 0.07
    star_align_sjoverhang_min             = 8
    star_outfilter_multimap_nmax          = 1
    star_seed_search_start_lmax           = 30
    star_additional                      = '--outSAMattributes NH HI AS nM XS'
    genotype_min_mapping_quality          = 30
    // UNMAP | SECONDARY | QCFAIL | SUPPLEMENTARY. Duplicates are marked later.
    genotype_exclude_flags                = '0xB04'

    // GATK HaplotypeCaller RNA-seq params
    gatk_dont_use_soft_clipped_bases      = true
    gatk_standard_min_confidence          = 20
    gatk_min_pruning                      = 1
    gatk_recover_all_dangling_branches    = true
    gatk_allow_nonunique_kmer             = false
    gatk_max_mnp_distance                 = 0
    run_bqsr                              = true

    // VariantFiltration options (can override via CLI/config)
    gatk_vf_cluster_size                  = 3
    gatk_vf_window_size                   = 35
    gatk_vf_fs_filter                     = 60.0
    gatk_vf_qd_filter                     = 2.0
    gatk_vf_qual_filter                   = 30.0
    gatk_vf_sor_filter                    = 3.0
    gatk_vf_mq_filter                     = 40.0
    gatk_vf_mq_rank_sum_filter            = -12.5
    gatk_vf_read_pos_rank_sum_filter      = -8.0
    genotype_min_depth                    = 8
    genotype_min_gq                       = 20

    // Optional controls for the demultiplexing-ready bulk SNP output.
    // The panel must be a normalized common germline SNP VCF on this reference.
    // The BED should combine RNA-editing and difficult-region exclusions.
    demux_snp_panel                       = ''
    demux_snp_panel_tbi                   = ''
    demux_exclude_regions                 = ''
    demux_max_missing_fraction            = 0.20
    demux_min_pairwise_discordant_snps    = 50

}
