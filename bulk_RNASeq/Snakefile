    "RRNA_DB_FILE": RRNA_DB_FILE,
    "STAR_PARAMS": STAR_PARAMS,
    "GATK_PARAMS": GATK_PARAMS,
    "FORMAT_CONTIGS": FORMAT_CONTIGS,
    "CONTIG_FORMAT_MAP": CONTIG_FORMAT_MAP,
    "FRAG_MEAN": FRAG_MEAN,
    "FRAG_STD": FRAG_STD,
    "ADAPTER_1": ADAPTER_1,
    "ADAPTER_2": ADAPTER_2,
    # helpers
    "merged_fastq_se": merged_fastq_se,
    "merged_fastq_pe": merged_fastq_pe,
    "fastp_outputs_se": fastp_outputs_se,
    "fastp_outputs_pe": fastp_outputs_pe,
    "reads_for_downstream": reads_for_downstream,
    "star_prefix": star_prefix,
    "star_sorted_bam": star_sorted_bam,
    "star_transcriptome_bam": star_transcriptome_bam,
    "star_gene_counts": star_gene_counts,
    "star_log_final": star_log_final,
    "mapped_bam": mapped_bam,
    "mapped_transcriptome_bam": mapped_transcriptome_bam,
    "sorted_bam": sorted_bam,
    "sorted_bai": sorted_bai,
    "picard_bam": picard_bam,
    "picard_bai": picard_bai,
    "picard_metrics": picard_metrics,
    "split_bam": split_bam,
    "split_bai": split_bai,
    "bqsr_table": bqsr_table,
    "bqsr_bam": bqsr_bam,
    "bqsr_bai": bqsr_bai,
    "haplotype_vcf": haplotype_vcf,
    "haplotype_tbi": haplotype_tbi,
    "filtered_vcf": filtered_vcf,
    "filtered_tbi": filtered_tbi,
    "formatted_vcf": formatted_vcf,
    "sorted_vcf": sorted_vcf,
    "sorted_tbi": sorted_tbi,
    "kallisto_outputs": kallisto_outputs,
    "rrna_ref_args": rrna_ref_args,
    "multiqc_inputs": multiqc_inputs
})

